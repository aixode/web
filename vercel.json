{
      "buildCommand": "node scripts/legal-sync.js",
      "outputDirectory": ".",
      "redirects": [
              { "source": "/missionandvision", "destination": "/mission", "permanent": true },
              { "source": "/pricing-plans/plans-pricing", "destination": "/pricing", "permanent": true },
              { "source": "/product-page/smartphone-x1", "destination": "/", "permanent": true },
              { "source": "/product-page/smartphone-y2", "destination": "/", "permanent": true },
              { "source": "/product-page/smartphone-z3", "destination": "/", "permanent": true },
              { "source": "/product-page/smartwatch-v2", "destination": "/", "permanent": true },
              { "source": "/product-page/ultra-slim-laptop", "destination": "/", "permanent": true },
              { "source": "/product-page/bluetooth-headset-pro", "destination": "/", "permanent": true },
              { "source": "/bluetoot/:path*", "destination": "/", "permanent": true },
                    { "source": "/favicon.ico", "destination": "/assets/favicon.png", "permanent": true },
              { "source": "/instagram", "destination": "/?utm_source=instagram&utm_medium=bio&utm_campaign=prelaunch#download", "permanent": false },
              { "source": "/tiktok", "destination": "/?utm_source=tiktok&utm_medium=bio&utm_campaign=prelaunch#download", "permanent": false },
              { "source": "/facebook", "destination": "/?utm_source=facebook&utm_medium=bio&utm_campaign=prelaunch#download", "permanent": false },
              { "source": "/snapchat", "destination": "/?utm_source=snapchat&utm_medium=bio&utm_campaign=prelaunch#download", "permanent": false },
              { "source": "/linkedin", "destination": "/?utm_source=linkedin&utm_medium=bio&utm_campaign=prelaunch#download", "permanent": false }
      ],
      "rewrites": [
              { "source": "/mission", "destination": "/mission.html" },
              { "source": "/about", "destination": "/about.html" },
              { "source": "/pricing", "destination": "/pricing.html" },
              { "source": "/support", "destination": "/support.html" },
              { "source": "/privacy", "destination": "/privacy.html" },
              { "source": "/coming-soon", "destination": "/coming-soon.html" },
              { "source": "/resources", "destination": "/resources.html" },
              { "source": "/resources/:slug", "destination": "/resources/:slug.html" },
              { "source": "/delete-account", "destination": "/delete-account.html" },
              { "source": "/terms", "destination": "/terms.html" }
      ],
      "headers": [
              {
                        "source": "/(.*)",
                        "headers": [
                                    { "key": "X-Content-Type-Options", "value": "nosniff" },
                                    { "key": "X-Frame-Options", "value": "DENY" }
                        ]
              }
      ]
}
